# Copy this file to .env and fill in your own values.

# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# URI (the "Transaction pooler" URI on port 6543 is recommended for an app
# that opens many short-lived connections, like this one).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Postgres schema this app's tables live in inside that Supabase project.
# Deliberately not "public". `python seed_db.py --reset` drops and recreates
# this schema from scratch.
DB_SCHEMA=loci

# If GROQ_API_KEY is left blank, the agent pipeline automatically falls back
# to a deterministic rule-based decision stub (see app/llm.py) so the demo
# keeps working offline. Every agent message records which backend decided it
# in message.model_backend ("groq" or "fallback_rules").
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Engine tuning (see ARCHITECTURE.md for why these defaults were picked).
HOP_CAP=3
ROUTING_THRESHOLD=0.6
