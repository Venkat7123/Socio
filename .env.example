# Copy this file to .env and fill in your key to use live Gemini decisions.
# If GEMINI_API_KEY is left blank, the agent pipeline automatically falls back
# to a deterministic rule-based decision stub (see app/llm.py) so the demo
# keeps working offline. Every agent message records which backend decided it
# in message.model_backend ("gemini" or "fallback_rules").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Path to the sqlite db file. Deleted + reseeded by `python seed_db.py --reset`.
DB_PATH=./loci.db

# Engine tuning (see ARCHITECTURE.md for why these defaults were picked).
HOP_CAP=3
ROUTING_THRESHOLD=0.6
