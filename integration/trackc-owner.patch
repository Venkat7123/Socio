+def test_llm_failure_is_an_error_message_not_a_silent_rule_decision(monkeypatch):
+    monkeypatch.setattr(llm, "LLM_BACKEND", "groq")
+    monkeypatch.setattr(llm, "GROQ_API_KEY", "")
+    m = agents.evaluate(P1, "corporation", persist=False)
+    assert m["type"] == "error" and m["model_backend"] == "unavailable"
+    assert m["error_reason"].startswith("llm_unavailable") and "GROQ_API_KEY" in m["error_reason"]
+    assert count("messages") == 0
