+def test_matrix_and_routing_seed_paths_come_from_the_environment(monkeypatch, tmp_path):
+    monkeypatch.setenv("MATRIX_PATH", str(tmp_path / "m.json"))
+    monkeypatch.setenv("ROUTING_SEED_PATH", str(tmp_path / "r.json"))
+    importlib.reload(config)
+    try:
+        assert config.MATRIX_PATH == tmp_path / "m.json" and config.ROUTING_SEED_PATH == tmp_path / "r.json"
+    finally:
+        monkeypatch.undo()
+        importlib.reload(config)
+    assert config.MATRIX_PATH.name == "jurisdiction_matrix.json"
