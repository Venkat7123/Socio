@@ -0,0 +1,112 @@
+"""Tests for the changes that let another service (the backend engine) own the case and call these agents.
+
+Runs on the rules backend (see conftest.py); the model call itself is faked where it matters.
+"""
+import importlib
+import time
+
+import pytest
+from fastapi.testclient import TestClient
+
+from app import agents, config, llm, validation
+from app.db import session
+from app.main import app
+
+client = TestClient(app)
+P1 = {"id": "X-1", "category": "pothole", "ward": "W-12", "lat": 13.08300, "lng": 80.27100}
+P4 = {"id": "X-4", "category": "pothole", "ward": "W-12", "lat": 13.08400, "lng": 80.27300}
+
+
+def count(table: str) -> int:
+    with session() as conn:
+        return conn.execute(f"SELECT COUNT(*) AS c FROM {table}").fetchone()["c"]
+
+
+def test_inline_evaluate_is_stateless():
+    r = client.post("/agents/corporation/evaluate-inline", json={"case": P1})
+    assert r.status_code == 200
+    m = r.json()
+    assert m["type"] == "accept" and m["from"] == "corporation_agent" and m["model_backend"] == "rules"
+    assert any(e["kind"] == "presence" for e in m["evidence"])
+    assert count("cases") == 0 and count("messages") == 0  # nothing about the case is stored here
+    assert client.post("/agents/nobody/evaluate-inline", json={"case": P1}).status_code == 404
+
+
+def test_inline_evaluate_uses_the_transcript_it_is_given():
+    seen = {}
+    real = llm.decide
+    llm.decide = lambda dept, case, facts, transcript, retry_feedback=None: (seen.update(t=transcript) or real(dept, case, facts, transcript))
+    try:
+        t = [{"type": "reject", "from": "water_board_agent", "evidence": []}]
+        client.post("/agents/corporation/evaluate-inline", json={"case": P1, "transcript": t})
+    finally:
+        llm.decide = real
+    assert seen["t"] == t
+
+
+def test_reject_without_evidence_is_refused(monkeypatch):
+    bad = {"type": "reject", "cite_refs": [], "target": "highways", "target_basis": "matrix_rule:M-POT-2",
+           "sub_tasks": [], "missing": [], "rationale": "no idea"}
+    monkeypatch.setattr(llm, "decide", lambda *a, **k: (dict(bad), "groq:test"))
+    m = agents.evaluate(P4, "corporation", persist=False)
+    assert m["type"] == "error" and "at least one cited evidence ref" in m["error_reason"]
+    assert m["model_backend"] == "groq:test"
+
+
+def test_absence_only_reject_confidence_is_capped_at_070():
+    absence = {"kind": "absence", "ref": "a"}
+    jr = {"kind": "jurisdiction_rule", "ref": "j"}
+    logged = {"a": {"result": {}}, "j": {"result": {"in_jurisdiction": False}}}
+    assert validation._reject_confidence([absence, jr], logged) == 0.70  # was 0.75
+    assert validation._reject_confidence([absence], logged) == 0.60
+    assert validation._reject_confidence([absence, {"kind": "handover_record", "ref": "h"}], logged) == 0.85
