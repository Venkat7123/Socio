+def test_slow_model_times_out(monkeypatch):
+    import groq
+
+    class Slow:
+        def __init__(self, **kw):
+            self.chat = type("C", (), {"completions": type("X", (), {"create": staticmethod(lambda **k: time.sleep(5))})()})()
+
+    monkeypatch.setattr(groq, "Groq", Slow)
+    monkeypatch.setattr(llm, "GROQ_API_KEY", "k")
+    monkeypatch.setattr(llm, "LLM_TIMEOUT_S", 0.3)
+    t = time.time()
+    with pytest.raises(llm.LLMUnavailable) as e:
+        llm.complete_json("s", "u")
+    assert time.time() - t < 2 and "exceeded" in str(e.value)
+
+
+def test_unparseable_model_output_is_unavailable(monkeypatch):
+    import groq
+
+    msg = type("M", (), {"content": "not json"})()
+    resp = type("R", (), {"choices": [type("Ch", (), {"message": msg})()]})()
+    fake = type("G", (), {"__init__": lambda self, **kw: None,
+                          "chat": type("C", (), {"completions": type("X", (), {"create": staticmethod(lambda **k: resp)})()})()})
+    monkeypatch.setattr(groq, "Groq", fake)
+    monkeypatch.setattr(llm, "GROQ_API_KEY", "k")
+    with pytest.raises(llm.LLMUnavailable):
+        llm.complete_json("s", "u")
+
